# $NetBSD$

DISTNAME=	alembic-1.8.12
CATEGORIES=	graphics
MASTER_SITES=	${MASTER_SITE_GITHUB:=alembic/}
GITHUB_TAG=	${PKGVERSION_NOREV}

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://www.alembic.io/
COMMENT=	Open framework for storing and sharing scene data
LICENSE=	modified-bsd

USE_LANGUAGES=		c c++
USE_CXX_FEATURES=	c++14

CMAKE_CONFIGURE_ARGS+=	-DCMAKE_BUILD_TYPE=Release
CMAKE_CONFIGURE_ARGS+=	-DUSE_HDF5=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_PYALEMBIC=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_ARNOLD=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_MAYA=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_PRMAN=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_TESTS=OFF
CMAKE_CONFIGURE_ARGS+=	-DUSE_BINARIES=ON
CMAKE_CONFIGURE_ARGS+=	-DALEMBIC_SHARED_LIBS=ON
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_SKIP_BUILD_RPATH=ON

.include "../../devel/cmake/build.mk"
.include "../../math/imath/buildlink3.mk"
.include "../../mk/bsd.pkg.mk"
