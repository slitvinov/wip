# $NetBSD$

DISTNAME=	lib3mf-2.5.0
PKGNAME=	${PYPKGPREFIX}-${DISTNAME}
CATEGORIES=	cad graphics python
MASTER_SITES=	${MASTER_SITE_GITHUB:=3MFConsortium/}
GITHUB_PROJECT=	lib3mf
GITHUB_TAG=	v${PKGVERSION_NOREV}
DISTINFO_FILE=	${.CURDIR}/../../wip/lib3mf/distinfo
PATCHDIR=	${.CURDIR}/../../wip/lib3mf/patches

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://3mf.io/
COMMENT=	Python binding for lib3mf, the 3MF file format library
LICENSE=	2-clause-bsd

DEPENDS+=	lib3mf-${PKGVERSION_NOREV}{,nb*}:../../wip/lib3mf

NO_BUILD=	yes
USE_LANGUAGES=	# none

# The binding is the ctypes module generated by upstream
# (Autogenerated/Bindings/Python/Lib3MF.py).  Install it as the "lib3mf"
# package like the PyPI wheel, whose __init__.py is not in the source
# tree (files/__init__.py replaces it), and point lib3mf/lib3mf.dylib
# (or .so) at the shared library from wip/lib3mf: Lib3MF.Wrapper()
# and build123d load the library from the package directory.
.include "../../mk/bsd.prefs.mk"
.if ${OPSYS} == "Darwin"
LIB3MF_SOEXT=	dylib
.else
LIB3MF_SOEXT=	so
.endif
PLIST_SUBST+=	LIB3MF_SOEXT=${LIB3MF_SOEXT}

INSTALLATION_DIRS+=	${PYSITELIB}/lib3mf

do-install:
	${INSTALL_DATA} ${WRKSRC}/Autogenerated/Bindings/Python/Lib3MF.py \
		${DESTDIR}${PREFIX}/${PYSITELIB}/lib3mf/
	${INSTALL_DATA} ${FILESDIR}/__init__.py \
		${DESTDIR}${PREFIX}/${PYSITELIB}/lib3mf/
	${LN} -sf ${PREFIX}/lib/lib3mf.${LIB3MF_SOEXT} \
		${DESTDIR}${PREFIX}/${PYSITELIB}/lib3mf/lib3mf.${LIB3MF_SOEXT}

post-install:
	${PY_COMPILE_ALL} -d ${PREFIX}/${PYSITELIB}/lib3mf \
		${DESTDIR}${PREFIX}/${PYSITELIB}/lib3mf

PY_PATCHPLIST=	yes
.include "../../lang/python/extension.mk"
.include "../../mk/bsd.pkg.mk"
